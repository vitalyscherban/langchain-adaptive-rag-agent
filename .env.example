# --- OpenAI-compatible API credentials ---
# Works with OpenAI, Azure OpenAI, or any OpenAI-compatible endpoint (e.g. vLLM, LiteLLM proxy).
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model routing ---
# Cheap model used for simple/factual queries.
CHEAP_MODEL=gpt-4o-mini
# Strong model used for complex/multi-hop queries.
STRONG_MODEL=gpt-4o
# Embedding model used for chunk/query embeddings.
EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
# Local, on-disk Chroma persistence directory.
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=adaptive_rag_docs

# --- Retrieval tuning ---
# Top-k range used for simple vs complex queries.
SIMPLE_TOP_K_MIN=1
SIMPLE_TOP_K_MAX=3
COMPLEX_TOP_K_MIN=5
COMPLEX_TOP_K_MAX=8
# Multiplier applied before MMR re-ranking narrows results down to top-k.
MMR_FETCH_K_MULTIPLIER=4
MMR_LAMBDA=0.5

# --- Token budget enforcement ---
# Hard cap on tokens allowed in the assembled context passed to the LLM.
CONTEXT_TOKEN_BUDGET=1500

# --- Conversation memory ---
# Token threshold above which ConversationSummaryBufferMemory starts summarizing.
MEMORY_MAX_TOKEN_LIMIT=800

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
# Set to "true" to use experimental SemanticChunker (requires langchain-experimental + embeddings call).
USE_SEMANTIC_CHUNKER=false

# --- Cost tracking ---
# Path to JSON-lines log file for token/cost/latency tracking.
TRACKING_LOG_PATH=./logs/usage.jsonl

# --- Pricing (USD per 1K tokens) used for cost estimation ---
CHEAP_MODEL_PROMPT_PRICE_PER_1K=0.00015
CHEAP_MODEL_COMPLETION_PRICE_PER_1K=0.0006
STRONG_MODEL_PROMPT_PRICE_PER_1K=0.0025
STRONG_MODEL_COMPLETION_PRICE_PER_1K=0.01
